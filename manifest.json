{
    "manifest_version": 3,
    "name": "SnapTranslate",
    "version": "1.0.1",
    "description": "Select any region of a webpage, extract the text with on-device OCR, and translate it instantly using the DeepL Translation API.",
    "permissions": ["activeTab", "scripting", "tabs", "storage", "offscreen"],

    "host_permissions": ["<all_urls>"],
    "background": {
        "service_worker": "src/background/background.js",
        "type": "module"
    },
    "action": {
        "default_popup": "src/popup/popup.html",
        "default_icon": {
            "16": "src/icons/icon16.png",
            "32": "src/icons/icon32.png",
            "48": "src/icons/icon48.png",
            "128": "src/icons/icon128.png"
        }
    },
    "options_page": "src/options/options.html",
    "icons": {
        "16": "src/icons/icon16.png",
        "32": "src/icons/icon32.png",
        "48": "src/icons/icon48.png",
        "128": "src/icons/icon128.png"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["src/content/contentScript.js"],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "src/vendor/tesseract/worker.min.js",
                "src/vendor/tesseract/tesseract-core.wasm.js",
                "src/vendor/tesseract/tesseract-core.wasm",
                "src/vendor/tesseract/lang-data/**"
            ],
            "matches": ["<all_urls>"],
            "extension_pages": true
        }
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    }
}
